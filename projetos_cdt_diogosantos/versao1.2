            fg="white"
        ).grid(
            row=1,
            column=2,
            pady=10
        )

    # ======================================================
    # ADICIONAR AO CARRINHO
    # ======================================================

    def adicionar_carrinho(self):

        selecionado = self.tabela.selection()

        if not selecionado:

            messagebox.showwarning(
                "Atenção",
                "Selecione uma camisa."
            )

            return

        try:

            quantidade = int(
                self.campo_quantidade.get()
            )

            if quantidade <= 0:
                raise ValueError

        except ValueError:

            messagebox.showerror(
                "Erro",
                "Digite uma quantidade válida."
            )

            return

        item = self.tabela.item(
            selecionado[0]
        )

        valores = item["values"]

        produto = valores[1]

        preco_texto = str(
            valores[2]
        ).replace(
            "R$ ",
            ""
        ).replace(
            ",",
            "."
        )

        preco = float(
            preco_texto
        )

        subtotal = preco * quantidade

        time = produto.replace(
            "Camisa ",
            ""
        )

        brinde = obter_brinde(
            time
        )

        self.carrinho.append({
            "produto": produto,
            "quantidade": quantidade,
            "subtotal": subtotal,
            "brinde": brinde
        })

        self.atualizar_carrinho()

        messagebox.showinfo(
            "Sucesso",
            f"Camisa adicionada ao carrinho!\n\n"
            f"Produto: {produto}\n"
            f"Quantidade: {quantidade}\n\n"
            f"Brinde incluso:\n"
            f"{brinde}\n\n"
            f"Taxa de entrega: R$ {TAXA_ENTREGA:.2f}"
        )

    # ======================================================
    # ATUALIZAR CARRINHO
    # ======================================================

    def atualizar_carrinho(self):

        for item in self.lista_carrinho.get_children():

            self.lista_carrinho.delete(
                item
            )

        for item in self.carrinho:

            self.lista_carrinho.insert(
                "",
                "end",
                values=(
                    item["produto"],
                    item["quantidade"],
                    item["brinde"],
                    f"R$ {item['subtotal']:.2f}"
                )
            )

        total_camisas = calcular_total_camisas(
            self.carrinho
        )

        total_final = calcular_total(
            self.carrinho
        )

        self.label_total.config(
            text=(
                f"Camisas: R$ {total_camisas:.2f}\n"
                f"Entrega: R$ {TAXA_ENTREGA:.2f}\n"
                f"Total: R$ {total_final:.2f}"
            )
        )

    # ======================================================
    # REMOVER DO CARRINHO
    # ======================================================

    def remover_carrinho(self):

        selecionado = self.lista_carrinho.selection()

        if not selecionado:

            messagebox.showwarning(
                "Atenção",
                "Selecione um item do carrinho."
            )

            return

        indice = self.lista_carrinho.index(
            selecionado[0]
        )

        self.carrinho.pop(
            indice
        )

        self.atualizar_carrinho()

    # ======================================================
    # GERAR CLIENTE FAKER
    # ======================================================

    def gerar_cliente_gui(self):

        nome, email = gerar_cliente()

        self.campo_cliente.delete(
            0,
            tk.END
        )

        self.campo_cliente.insert(
            0,
            nome
        )

        messagebox.showinfo(
            "Cliente Faker",
            f"Nome: {nome}\n"
            f"E-mail: {email}"
        )

    # ======================================================
    # FINALIZAR PEDIDO
    # ======================================================

    def finalizar_pedido(self):

        if not self.carrinho:

            messagebox.showwarning(
                "Atenção",
                "Adicione uma camisa ao carrinho."
            )

            return

        cliente = self.campo_cliente.get().strip()

        if not cliente:

            messagebox.showwarning(
                "Atenção",
                "Digite o nome do cliente."
            )

            return

        total_camisas = calcular_total_camisas(
            self.carrinho
        )

        total, data = salvar_pedido(
            cliente,
            self.carrinho
        )

        texto_brindes = ""

        for item in self.carrinho:

            texto_brindes += (
                f"- {item['produto']}: "
                f"{item['brinde']}\n"
            )

        messagebox.showinfo(
            "Pedido Finalizado",
            f"Cliente: {cliente}\n"
            f"Valor das camisas: R$ {total_camisas:.2f}\n"
            f"Taxa de entrega: R$ {TAXA_ENTREGA:.2f}\n"
            f"Total final: R$ {total:.2f}\n"
            f"Data: {data}\n\n"
            f"BRINDES INCLUSOS:\n"
            f"{texto_brindes}\n"
            f"Obrigado pela compra!"
        )

        self.carrinho.clear()

        self.atualizar_carrinho()

        self.campo_cliente.delete(
            0,
            tk.END
        )

    # ======================================================
    # HISTÓRICO DE PEDIDOS
    # ======================================================

    def mostrar_historico(self):

        pedidos = listar_historico()

        janela_historico = tk.Toplevel(
            self.janela
        )

        janela_historico.title(
            "Histórico de Pedidos"
        )

        janela_historico.geometry(
            "700x400"
        )

        tabela = ttk.Treeview(
            janela_historico,
            columns=(
                "id",
                "cliente",
                "total",
                "data"
            ),
            show="headings"
        )

        tabela.heading(
            "id",
            text="ID"
        )

        tabela.heading(
            "cliente",
            text="Cliente"
        )

        tabela.heading(
            "total",
            text="Total"
        )

        tabela.heading(
            "data",
            text="Data"
        )

        tabela.column(
            "id",
            width=60,
            anchor="center"
        )

        tabela.column(
            "cliente",
            width=200
        )

        tabela.column(
            "total",
            width=120,
            anchor="center"
        )

        tabela.column(
            "data",
            width=150,
            anchor="center"
        )

        tabela.pack(
            fill="both",
            expand=True,
            padx=10,
            pady=10
        )

        for pedido in pedidos:

            pedido_id, cliente, total, data = pedido

            tabela.insert(
                "",
                "end",
                values=(
                    pedido_id,
                    cliente,
                    f"R$ {total:.2f}",
                    data
                )
            )


