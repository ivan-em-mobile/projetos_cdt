
import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3
import json
from datetime import datetime
from faker import Faker


# ==========================================================
# CONFIGURAÇÕES DA LOJA
# ==========================================================

NOME_LOJA = "LOJA DO DIOGO E MATHEUS"
SUBTITULO = "A PRONTA ENTREGA"
BANDEIRA = "🇧🇷"

BANCO_DADOS = "loja_camisas.db"
ARQUIVO_JSON = "configuracao.json"

TAXA_ENTREGA = 10.00

fake = Faker("pt_BR")


# ==========================================================
# TIMES BRASILEIROS
# ==========================================================

TIMES = [
    "Athletico-PR",
    "Atletico-MG",
    "Bahia",
    "Botafogo",
    "Chapecoense",
    "Corinthians",
    "Coritiba",
    "Cruzeiro",
    "Flamengo",
    "Fluminense",
    "Gremio",
    "Internacional",
    "Mirassol",
    "Palmeiras",
    "Red Bull Bragantino",
    "Remo",
    "Santos",
    "Sao Paulo",
    "Vasco",
    "Vitoria"
]


# ==========================================================
# PREÇOS DAS CAMISAS
# ==========================================================

PRECOS = {}

for time in TIMES:

    if time == "Internacional":
        PRECOS[time] = 200.00

    elif time in [
        "Fluminense",
        "Corinthians",
        "Gremio",
        "Botafogo"
    ]:
        PRECOS[time] = 180.00

    else:
        PRECOS[time] = 120.00


# ==========================================================
# BRINDES DAS CAMISAS
# ==========================================================

def obter_brinde(time):

    if time == "Internacional":
        return "Bone do Inter + Caneca do Inter"

    return f"Bone do {time} + Caneca do {time}"


# ==========================================================
# BANCO DE DADOS SQLITE
# ==========================================================

def conectar_banco():

    return sqlite3.connect(BANCO_DADOS)


def preparar_banco():

    conexao = conectar_banco()
    cursor = conexao.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS produtos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL UNIQUE,
            preco REAL NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS clientes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            email TEXT NOT NULL
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS pedidos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            cliente TEXT NOT NULL,
            total REAL NOT NULL,
            data TEXT NOT NULL
        )
    """)

    for time in TIMES:

        nome_produto = f"Camisa {time}"
        preco = PRECOS[time]

        cursor.execute("""
            INSERT OR IGNORE INTO produtos
            (nome, preco)
            VALUES (?, ?)
        """, (
            nome_produto,
            preco
        ))

        cursor.execute("""
            UPDATE produtos
            SET preco = ?
            WHERE nome = ?
        """, (
            preco,
            nome_produto
        ))

    conexao.commit()
    conexao.close()


# ==========================================================
# ARQUIVO JSON
# ==========================================================

def salvar_configuracao_json():

    configuracao = {
        "nome_loja": NOME_LOJA,
        "subtitulo": SUBTITULO,
        "bandeira": BANDEIRA,
        "categoria": "Camisas de Times Brasileiros",
        "quantidade_times": len(TIMES),
        "taxa_entrega": TAXA_ENTREGA,
        "times": TIMES,
        "precos": PRECOS
    }

    with open(
        ARQUIVO_JSON,
        "w",
        encoding="utf-8"
    ) as arquivo:

        json.dump(
            configuracao,
            arquivo,
            ensure_ascii=False,
            indent=4
        )


# ==========================================================
# FUNÇÕES DO SISTEMA
# ==========================================================

def listar_produtos():

    conexao = conectar_banco()

    produtos = conexao.execute("""
        SELECT id, nome, preco
        FROM produtos
        ORDER BY id
    """).fetchall()

    conexao.close()

    return produtos


def calcular_total_camisas(carrinho):

    return sum(
        item["subtotal"]
        for item in carrinho
    )


def calcular_total(carrinho):

    total_camisas = calcular_total_camisas(carrinho)

    return total_camisas + TAXA_ENTREGA


def salvar_pedido(cliente, carrinho):

    total = calcular_total(carrinho)

    data = datetime.now().strftime(
        "%d/%m/%Y %H:%M"
    )

    conexao = conectar_banco()

    conexao.execute("""
        INSERT INTO pedidos
        (cliente, total, data)
        VALUES (?, ?, ?)
    """, (
        cliente,
        total,
        data
    ))

    conexao.commit()
    conexao.close()

    return total, data


def salvar_cliente(nome, email):

    conexao = conectar_banco()

    conexao.execute("""
        INSERT INTO clientes
        (nome, email)
        VALUES (?, ?)
    """, (
        nome,
        email
    ))

    conexao.commit()
    conexao.close()


def gerar_cliente():

    nome = fake.name()
    email = fake.email()

    salvar_cliente(
        nome,
        email
    )

    return nome, email


def listar_historico():

    conexao = conectar_banco()

    pedidos = conexao.execute("""
        SELECT id, cliente, total, data
        FROM pedidos
        ORDER BY id DESC
    """).fetchall()

    conexao.close()

    return pedidos


# ==========================================================
# INTERFACE TKINTER
# ==========================================================

class Aplicacao:

    def __init__(self, janela):

        self.janela = janela

        self.janela.title(
            NOME_LOJA
        )

        self.janela.geometry(
            "1150x760"
        )

        self.janela.minsize(
            950,
            650
        )

        self.carrinho = []

        self.criar_fundo()
        self.criar_interface()

    # ======================================================
    # FUNDO METADE BRANCO E METADE VERMELHO
    # ======================================================

    def criar_fundo(self):

        self.fundo = tk.Canvas(
            self.janela,
            highlightthickness=0
        )

        self.fundo.pack(
            fill="both",
            expand=True
        )

        self.fundo.bind(
            "<Configure>",
            self.desenhar_fundo
        )

    def desenhar_fundo(self, evento=None):

        largura = self.janela.winfo_width()
        altura = self.janela.winfo_height()

        metade = largura // 2

        self.fundo.delete(
            "fundo"
        )

        self.fundo.create_rectangle(
            0,
            0,
            metade,
            altura,
            fill="white",
            outline="",
            tags="fundo"
        )

        self.fundo.create_rectangle(
            metade,
            0,
            largura,
            altura,
            fill="#c62828",
            outline="",
            tags="fundo"
        )

    # ======================================================
    # INTERFACE PRINCIPAL
    # ======================================================

    def criar_interface(self):

        self.conteudo = tk.Frame(
            self.fundo,
            bg="white",
            padx=20,
            pady=10
        )

        self.fundo.create_window(
            0,
            0,
            anchor="nw",
            window=self.conteudo,
            tags="conteudo"
        )

        self.fundo.bind(
            "<Configure>",
            self.ajustar_conteudo,
            add="+"
        )

        titulo = tk.Label(
            self.conteudo,
            text=NOME_LOJA,
            font=("Arial", 24, "bold"),
            bg="white",
            fg="#b71c1c"
        )

        titulo.pack(
            pady=5
        )

        subtitulo = tk.Label(
            self.conteudo,
            text=SUBTITULO,
            font=("Arial", 14, "bold"),
            bg="white",
            fg="#333333"
        )

        subtitulo.pack(
            pady=2
        )

        bandeira = tk.Label(
            self.conteudo,
            text=BANDEIRA,
            font=("Arial", 28),
            bg="white"
        )

        bandeira.pack(
            pady=3
        )

        entrega = tk.Label(
            self.conteudo,
            text="Taxa de entrega fixa: R$ 10,00",
            font=("Arial", 11, "bold"),
            bg="white",
            fg="#c62828"
        )

        entrega.pack(
            pady=3
        )

        self.criar_area_produtos()
        self.criar_area_compra()
        self.criar_area_carrinho()
        self.criar_area_finalizacao()

    def ajustar_conteudo(self, evento=None):

        largura = self.janela.winfo_width()
        altura = self.janela.winfo_height()

        self.fundo.itemconfig(
            "conteudo",
            width=max(
                500,
                largura // 2
            ),
            height=altura
        )

    # ======================================================
    # ÁREA DE PRODUTOS
