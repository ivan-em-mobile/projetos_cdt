    # ======================================================
    # FINALIZAÇÃO
    # ======================================================

    def criar_area_finalizacao(self):

        frame = tk.Frame(
            self.conteudo,
            bg="white"
        )

        frame.pack(
            pady=8
        )

        tk.Label(
            frame,
            text="Nome do Cliente:",
            bg="white",
            font=("Arial", 11)
        ).grid(
            row=0,
            column=0,
            padx=5
        )

        self.campo_cliente = tk.Entry(
            frame,
