        self.tabela.heading(
            "numero",
            text="Número"
        )

        self.tabela.heading(
            "produto",
            text="Camisa"
        )

        self.tabela.heading(
            "preco",
            text="Preço"
        )

        self.tabela.heading(
            "brinde",
            text="Brinde"
        )

        self.tabela.column(
            "numero",
            width=70,
            anchor="center"
        )

        self.tabela.column(
            "produto",
            width=210
        )

        self.tabela.column(
            "preco",
            width=100,
            anchor="center"
        )

        self.tabela.column(
            "brinde",
            width=300
        )

        self.tabela.pack(
            side="left",
            fill="both",
            expand=True
